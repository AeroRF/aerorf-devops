# =============================================================================
# Produção — serviços EXTERNOS (fora dos containers da aplicação)
# =============================================================================
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=https://app.aerorf.com.br

# PostgreSQL dedicado
DATABASE_URL=postgres://aerorf_user:CHANGE_ME@db.aerorf.internal:5432/aerorf

# Redis (managed ou VM dedicada)
REDIS_URL=redis://redis.aerorf.internal:6379

# MinIO / S3 dedicado
S3_ENDPOINT=https://storage.aerorf.internal
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=aerorf-prod
S3_FORCE_PATH_STYLE=true

# JWT RS256 — usar secrets manager / K8s secrets
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public
JWT_ISSUER=aerorf-auth-api

# Observabilidade externa
OTEL_EXPORTER_OTLP_ENDPOINT=https://obs.aerorf.internal:4318
PROMETHEUS_REMOTE_WRITE_URL=https://obs.aerorf.internal/api/v1/write
LOKI_PUSH_URL=https://obs.aerorf.internal/loki/api/v1/push

NEXT_PUBLIC_API_URL=https://api.aerorf.com.br/api/v1
