# =============================================================================
# Desenvolvimento — serviços embutidos no compose
# =============================================================================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://aerorf:aerorf@localhost:6432/aerorf
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aerorf
S3_SECRET_KEY=aerorf_secret
S3_BUCKET=aerorf-dev
S3_FORCE_PATH_STYLE=true

JWT_PRIVATE_KEY_PATH=../../infra/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../infra/keys/jwt-public.pem
JWT_ISSUER=aerorf-auth-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

LOG_LEVEL=debug
# Browser usa proxy same-origin; servidor Next encaminha para a API interna.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_MODE=marketing  # preview landing no localhost (rewrite / → HTML legado)
API_INTERNAL_URL=http://api:4000

# Observabilidade local (somente dev — prod usa stack externa)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093
# Grafana (credenciais via GitHub secrets GRAFANA_ADMIN_USER / GRAFANA_ADMIN_PASSWORD)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Slack — alertas + CI/CD
SLACK_WEBHOOK_URL=

# E-mail (Resend) — fila de notificações operacionais
# GitHub Secrets: RESEND_API_KEY, RESEND_FROM_EMAIL (opcional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AeroRF Alertas <onboarding@resend.dev>
NOTIFICATIONS_ENABLED=true
NOTIFICATION_COOLDOWN_HOURS=24
NOTIFICATION_WORKER_INTERVAL_MS=30000
APP_PUBLIC_URL=http://localhost:3000
