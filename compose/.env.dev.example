# =============================================================================
# Desenvolvimento — serviços embutidos no compose
# =============================================================================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://aerorf:aerorf@localhost:6432/aerorf
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aerorf
S3_SECRET_KEY=aerorf_secret
S3_BUCKET=aerorf-dev
S3_FORCE_PATH_STYLE=true

JWT_PRIVATE_KEY_PATH=../keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../keys/jwt-public.pem
JWT_ISSUER=aerorf-auth-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

LOG_LEVEL=debug
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Caminho para clone do repo backend (migrate/seed)
AERORF_BACKEND_DIR=../aerorf-backend

# Tags das imagens GHCR (profile apps)
AERORF_BACKEND_TAG=latest
AERORF_FRONTEND_TAG=latest

# Observabilidade local
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
