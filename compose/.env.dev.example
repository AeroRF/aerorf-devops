# =============================================================================
# Desenvolvimento — serviços embutidos no compose
# VPS HostGator: substitua VPS_HOST pelo IP ou domínio público
# =============================================================================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# Ex.: VPS HostGator — http://123.45.67.89:3000
VPS_HOST=SEU_IP_OU_DOMINIO
CORS_ORIGIN=http://SEU_IP_OU_DOMINIO:3000
NEXT_PUBLIC_API_URL=/api/v1

# Host-only (migrate/seed no VPS). Containers API usam DATABASE_URL do compose.
# DATABASE_URL=postgres://aerorf:aerorf@localhost:5433/aerorf
# Redis só na rede Docker (compose); API usa redis://redis:6379
REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aerorf
S3_SECRET_KEY=aerorf_secret
S3_BUCKET=aerorf-dev
S3_FORCE_PATH_STYLE=true

JWT_PRIVATE_KEY_PATH=../keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../keys/jwt-public.pem
JWT_ISSUER=aerorf-auth-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

LOG_LEVEL=debug

AERORF_BACKEND_DIR=../aerorf-backend
AERORF_BACKEND_TAG=latest
AERORF_FRONTEND_TAG=latest

# GHCR_TOKEN e GHCR_USER — export no shell ou descomente:
# GHCR_TOKEN=
# GHCR_USER=

PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
