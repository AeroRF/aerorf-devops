# Observabilidade — development (VPS via pipeline)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093

# Grafana — credenciais (definir via GitHub secrets no environment development)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Slack — alertas Prometheus + CI/CD (Incoming Webhook)
SLACK_WEBHOOK_URL=

# E-mail (Resend) — GitHub Secrets: RESEND_API_KEY, RESEND_FROM_EMAIL
RESEND_API_KEY=
RESEND_FROM_EMAIL=AeroRF Alertas <onboarding@resend.dev>
NOTIFICATIONS_ENABLED=true
NOTIFICATION_COOLDOWN_HOURS=24
NOTIFICATION_WORKER_INTERVAL_MS=30000
APP_PUBLIC_URL=http://SEU_IP_OU_DOMINIO:3000
