{
  "uid": "aerorf-overview",
  "title": "AeroRF — Visão Geral do Sistema",
  "tags": ["aerorf", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API online",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"aerorf-api\"}", "legendFormat": "api" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Web online",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"aerorf-web\"}", "legendFormat": "web" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erros 5xx (5 min)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(http_requests_total{status_class=\"5xx\"}[5m])) or vector(0)", "legendFormat": "5xx" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erros 4xx (5 min)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(http_requests_total{status_class=\"4xx\"}[5m])) or vector(0)", "legendFormat": "4xx" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Falhas login (5 min)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(auth_login_failures_total[5m])) or vector(0)" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Erros storage (5 min)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(storage_operation_errors_total[5m])) or vector(0)" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requisições HTTP por classe",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status_class=\"2xx\"}[1m]))", "legendFormat": "2xx" },
        { "expr": "sum(rate(http_requests_total{status_class=\"4xx\"}[1m]))", "legendFormat": "4xx" },
        { "expr": "sum(rate(http_requests_total{status_class=\"5xx\"}[1m]))", "legendFormat": "5xx" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latência API P95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Proxy Next.js — erros",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(proxy_errors_total[1m])) by (reason)", "legendFormat": "{{reason}}" },
        { "expr": "sum(rate(proxy_requests_total{status_class=\"5xx\"}[1m]))", "legendFormat": "proxy 5xx" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Auth — falhas login/refresh",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(auth_login_failures_total[1m])) by (reason)", "legendFormat": "login {{reason}}" },
        { "expr": "sum(rate(auth_refresh_failures_total[1m])) by (reason)", "legendFormat": "refresh {{reason}}" }
      ]
    },
    {
      "id": 40,
      "type": "stat",
      "title": "E-mails falhos (15 min)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(notification_emails_total{result=\"failed\"}[15m])) or vector(0)", "legendFormat": "failed" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Gaps entrega — manutenção (15 min)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(notification_delivery_gaps_total{alert_module=\"manutencao\"}[15m])) or vector(0)", "legendFormat": "gaps" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 42,
      "type": "stat",
      "title": "Fila e-mail — pendentes",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "notification_queue_pending or vector(0)", "legendFormat": "pending" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 20 }] } } }
    },
    {
      "id": 43,
      "type": "stat",
      "title": "OS críticas ativas (manutenção)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "operational_critical_alerts_active{alert_module=\"manutencao\"} or vector(0)", "legendFormat": "os" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } } }
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "Notificações — e-mails por resultado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(notification_emails_total{result=\"sent\"}[5m])) by (alert_module)", "legendFormat": "sent {{alert_module}}" },
        { "expr": "sum(rate(notification_emails_total{result=\"failed\"}[5m])) by (alert_module)", "legendFormat": "failed {{alert_module}}" },
        { "expr": "sum(rate(notification_emails_total{result=\"enqueued\"}[5m])) by (alert_module)", "legendFormat": "enqueued {{alert_module}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "Notificações — gaps de entrega",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(notification_delivery_gaps_total[5m])) by (alert_module, reason)", "legendFormat": "{{alert_module}} — {{reason}}" },
        { "expr": "notification_queue_failed or vector(0)", "legendFormat": "fila failed" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "CPU servidor (%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "cpu" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Memória servidor (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "mem" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Disco livre (%)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}) * 100", "legendFormat": "disk free" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "PostgreSQL — conexões",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_stat_activity_count", "legendFormat": "connections" }]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Redis — memória",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "used" }]
    },
    {
      "id": 30,
      "type": "logs",
      "title": "Logs de erro (Loki)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\"aerorf.*|compose.*\"} | json | level=\"error\" or event=\"http_error\" or event=\"storage_error\" or event=\"proxy_error\"", "legendFormat": "" }
      ],
      "options": { "showTime": true, "showLabels": true, "sortOrder": "Descending" }
    },
    {
      "id": 31,
      "type": "table",
      "title": "Alertas Prometheus ativos",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
